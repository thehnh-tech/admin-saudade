BACKEND_URL=http://localhost:4000
MARKETPLACE_PUBLIC_URL=http://localhost:3000
ADMIN_PASSWORD=change-this-admin-password
ADMIN_SESSION_SECRET=change-this-long-random-session-secret

# Credentials this console uses to authenticate against the backend admin API.
# When BACKEND_ADMIN_PASSWORD is left empty, ADMIN_PASSWORD above is forwarded
# verbatim to the backend's /api/admin/login: in production, set both to
# DIFFERENT values so the console password and the backend password are not one
# and the same secret.
BACKEND_ADMIN_LOGIN=admin
BACKEND_ADMIN_PASSWORD=
